# Example: point job engine at LOCAL wbl-backend + workflow logs auth.
# Copy relevant lines into your real .env (or rename to .env for local-only testing).

BACKEND_URL=http://localhost:8000/api
TRIGGER_ENDPOINT=/weekly-workflow/trigger-run

# Clear production secret if it breaks local JWT
INTERNAL_SECRET_KEY=

# Workflow log API: use same login as Avatar (admin-capable user)
AUTH_URL=http://localhost:8000/api/login
AUTH_USERNAME=
AUTH_PASSWORD=

# Or paste JWT from POST /api/login
# API_ACCESS_TOKEN=

DEFAULT_AUTOMATION_WORKFLOW_ID=7
# DEFAULT_AUTOMATION_SCHEDULE_ID=
