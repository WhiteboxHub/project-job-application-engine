# Database Configuration
# MySQL/MariaDB for Sites & Selectors
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret
DB_NAME=job_engine

# DuckDB for History (File path)
DUCKDB_PATH=data/history.duckdb

# Browser Settings
# Path to Chrome User Data Directory for session persistence
CHROME_USER_DATA_DIR=./chrome_profile
HEADLESS=false

# Proxy Settings (Optional)
# Format: protocol://user:pass@host:port
PROXY_URL=

# Safety Limits
MAX_APPLICATIONS_PER_RUN=10
SUBMISSION_COOLDOWN_SECONDS=30
DRY_RUN=false

# Insight Global Search Defaults (use '|' to separate entries to avoid commas inside locations)
INSIGHT_KEYWORDS=AI Engineer|AI/ML Engineer|Machine Learning Engineer
INSIGHT_LOCATIONS=New York, NY|Atlanta, GA|Chicago, IL
INSIGHT_DISTANCE_DEFAULT=50

# Resume (optional)
RESUME_FILE_PATH=/absolute/path/to/resume.pdf
