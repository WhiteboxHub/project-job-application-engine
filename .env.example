# Database Configuration
# DuckDB for both configuration and history (single file)
DUCKDB_PATH=data/job_engine.duckdb

# --- wbl-backend API (weekly workflow + workflow execution logs) ---
# BACKEND_URL must include /api (e.g. http://127.0.0.1:8001/api)
# BACKEND_URL=http://127.0.0.1:8001/api
# TRIGGER_ENDPOINT=/weekly-workflow/trigger-run
# SCHEDULER_INTERNAL_SECRET=super-secret-weekly-workflow-key
# INTERNAL_SECRET_KEY=...   # optional legacy Bearer for some endpoints

# JWT: either paste a token, or login with username/password (admin-capable user for workflow logs)
# API_ACCESS_TOKEN=
# AUTH_URL=https://api.whitebox-learning.com/api/login
# AUTH_USERNAME=
# AUTH_PASSWORD=

# Or server internal scheduler header (must match backend X-Internal-Secret check)
# SCHEDULER_INTERNAL_SECRET=

# When schedule run_parameters has workflow_id=null, set Avatar workflow id (e.g. 7)
# DEFAULT_AUTOMATION_WORKFLOW_ID=7
# Optional: schedule row id from Workflows Scheduler grid (first column "ID")
# DEFAULT_AUTOMATION_SCHEDULE_ID=

# Browser Settings
# Path to Chrome User Data Directory for session persistence
CHROME_USER_DATA_DIR=./chrome_profile
HEADLESS=false
# Set to 'true' to keep the browser open after the script finishes (useful for debugging)
KEEP_BROWSER_OPEN=false

# Proxy Settings (Optional)
# Format: protocol://user:pass@host:port
PROXY_URL=

# Safety Limits
MAX_APPLICATIONS_PER_RUN=10
SUBMISSION_COOLDOWN_SECONDS=30
DRY_RUN=false
# Seconds to wait after clicking "Submit" to allow for navigation/confirmation
SUBMIT_POST_CLICK_WAIT=15

# Append full output.json text to this file after each run (leave empty to disable)
# EXECUTION_LOG_FILE=data/execution.log

# Platform Filter (Optional)
# Run only a specific site (e.g., 'KForce', 'Capgemini')
# Can be overridden by CLI argument --site
PLATFORM_FILTER=

# Insight Global Search Defaults (use '|' to separate entries to avoid commas inside locations)
INSIGHT_KEYWORDS=AI
INSIGHT_LOCATIONS=
INSIGHT_DISTANCE_DEFAULT=

# KForce Search Defaults
KFORCE_LOCATIONS=
KFORCE_DISTANCE_DEFAULT=

# Resume (Desired from HEAD, seems more specific than generic)
RESUME_FILE_PATH=resume/candidate_resume.pdf

# Capgemini Credentials (Required for Capgemini Strategy)
CAPGEMINI_EMAIL=your_email@example.com
CAPGEMINI_PASSWORD=your_password

# Email Reporting Setup
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
REPORT_RECEIVER_EMAIL=sairam818595@gmail.com
SENDER_EMAIL=ramsai54164@gmail.com
